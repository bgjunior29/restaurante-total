{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (API)",
      "type": "shell",
      "command": "${workspaceFolder}\\backendrestaurantetotal\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}\\backendrestaurantetotal" },
      "isBackground": true,
      "problemMatcher": []
