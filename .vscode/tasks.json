    {
      "label": "Frontend (web)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}\\frontrestaurantetotal" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Rodar Restaurante Total",
      "dependsOn": ["Backend (API)", "Frontend (web)"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
