{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "frontrestaurantetotal.vercel.app" }],
      "headers": { "X-Robots-Tag": "noindex" },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "https://restaurante-total-api.onrender.com/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    },
    { "handle": "filesystem" },
    { "src": "/r/(.*)", "dest": "/cardapio.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
